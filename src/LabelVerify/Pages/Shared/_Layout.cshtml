<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Label Check</title>
    <style>
        :root { --ink: #1a1a1a; --muted: #555; --line: #c8c8c8; --bg: #f6f6f4; --card: #fff;
                --ok: #1e6b34; --ok-bg: #e3f3e7; --warn: #8a5a00; --warn-bg: #fff3d6; --bad: #a3191f; --bad-bg: #fde4e4;
                --accent: #1d4ed8; }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--bg); color: var(--ink); font: 19px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
        nav { background: var(--card); border-bottom: 1px solid var(--line); }
        nav div { max-width: 960px; margin: 0 auto; padding: 0 16px; display: flex; gap: 8px; flex-wrap: wrap; }
        nav a { padding: 14px 12px; color: var(--accent); font-weight: 600; text-decoration: none; border-bottom: 4px solid transparent; }
        nav a[aria-current=page] { color: var(--ink); border-bottom-color: var(--accent); }
        main { max-width: 960px; margin: 0 auto; padding: 24px 16px 64px; }
        h1 { font-size: 30px; margin: 0 0 4px; }
        h2 { font-size: 22px; margin: 0 0 12px; }
        p.lead { margin: 0 0 24px; color: var(--muted); }
        .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 20px; margin-bottom: 20px; }
        label { display: block; font-weight: 600; margin: 14px 0 4px; }
        label small { font-weight: 400; color: var(--muted); }
        input[type=text], input[type=file] { width: 100%; font-size: 19px; padding: 10px 12px; border: 2px solid var(--line); border-radius: 8px; background: #fff; }
        input:focus, button:focus-visible, a:focus-visible, summary:focus-visible { outline: 3px solid var(--accent); outline-offset: 1px; }
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 20px; }
        button { margin-top: 20px; font-size: 22px; font-weight: 700; padding: 14px 32px; border: 0; border-radius: 10px; background: var(--accent); color: #fff; cursor: pointer; }
        button:disabled { background: #6b7280; cursor: wait; }
        button.secondary { font-size: 18px; padding: 10px 20px; background: #fff; color: var(--accent); border: 2px solid var(--accent); }
        .banner { font-size: 24px; font-weight: 700; padding: 16px 20px; border-radius: 10px; margin-bottom: 16px; }
        .banner.Match { background: var(--ok-bg); color: var(--ok); }
        .banner.NeedsReview { background: var(--warn-bg); color: var(--warn); }
        .banner.Mismatch { background: var(--bad-bg); color: var(--bad); }
        .error { background: var(--bad-bg); color: var(--bad); font-weight: 600; padding: 14px 18px; border-radius: 10px; margin-bottom: 20px; }
        .error ul { margin: 6px 0 0; padding-left: 22px; }
        table { width: 100%; border-collapse: collapse; table-layout: fixed; }
        th, td { text-align: left; vertical-align: top; padding: 10px 8px; border-bottom: 1px solid var(--line); }
        th { font-size: 16px; color: var(--muted); }
        table.fields th:nth-child(1) { width: 20%; } table.fields th:nth-child(2) { width: 22%; }
        td[data-label$="says"] { overflow-wrap: anywhere; }
        .verdict { display: inline-block; white-space: nowrap; font-weight: 700; padding: 2px 10px; border-radius: 999px; }
        .Match { background: var(--ok-bg); color: var(--ok); }
        .NeedsReview { background: var(--warn-bg); color: var(--warn); }
        .Mismatch, .Failed { background: var(--bad-bg); color: var(--bad); }
        .Pending { background: #eceff3; color: var(--muted); }
        .note { display: block; font-size: 16px; color: var(--muted); }
        .meta { font-size: 16px; color: var(--muted); }
        .previews { display: flex; flex-wrap: wrap; gap: 12px; }
        .preview { max-width: min(100%, 440px); max-height: 420px; border: 1px solid var(--line); border-radius: 8px; }
        @@media (max-width: 640px) {
            .grid { grid-template-columns: 1fr; }
            table.fields thead { display: none; }
            table.fields tr { display: block; padding: 10px 0; border-bottom: 1px solid var(--line); }
            table.fields td { display: block; border: 0; padding: 2px 0; }
            table.fields td[data-label]::before { content: attr(data-label) ": "; font-weight: 600; }
        }
    </style>
</head>
<body>
<nav aria-label="Pages">
    <div>
        <a href="/" aria-current="@(Context.Request.Path == "/" ? "page" : null)">Check one label</a>
        <a href="/Batch" aria-current="@(Context.Request.Path.StartsWithSegments("/Batch") ? "page" : null)">Check a batch</a>
    </div>
</nav>
<main>
    @RenderBody()
</main>
<script>
    // Phone photos can be several MB. Vision models scale images to fit 2048 px anyway, so shrink before upload.
    async function shrinkImage(file) {
        const maxSide = 2048;
        try {
            const bitmap = await createImageBitmap(file);
            const scale = Math.min(1, maxSide / Math.max(bitmap.width, bitmap.height));
            if (scale === 1 && file.size < 1500000) return file;
            const canvas = document.createElement('canvas');
            canvas.width = Math.round(bitmap.width * scale);
            canvas.height = Math.round(bitmap.height * scale);
            canvas.getContext('2d').drawImage(bitmap, 0, 0, canvas.width, canvas.height);
            bitmap.close();
            const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', 0.9));
            return blob && blob.size < file.size ? new File([blob], file.name, { type: 'image/jpeg' }) : file;
        } catch {
            return file;
        }
    }
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
