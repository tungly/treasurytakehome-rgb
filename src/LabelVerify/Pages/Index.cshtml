@page
@model LabelVerify.Pages.IndexModel
@{
    ViewData["Title"] = "Check one label";
    var outcome = Model.Outcome;
    var results = outcome?.Results;
}
<h1>Check one label</h1>
<p class="lead">Upload photos of the label, type in what the application says, then press <strong>Check label</strong>.</p>

@if (outcome?.Error is not null)
{
    <div class="error" role="alert">@outcome.Error</div>
}

@if (results is not null)
{
    <section class="card" aria-live="polite">
        <div class="banner @outcome!.Overall">@LabelCheck.Summary(results)</div>
        <table class="fields">
            <thead><tr><th>Field</th><th>Result</th><th>Application says</th><th>Label says</th></tr></thead>
            <tbody>
            @foreach (var r in results)
            {
                <tr>
                    <td><strong>@r.Field</strong></td>
                    <td data-label="Result">
                        <span class="verdict @r.Verdict">@(r.Verdict switch { Verdict.Match => "Match", Verdict.NeedsReview => "Needs review", _ => "Mismatch" })</span>
                        @if (r.Note.Length > 0) { <span class="note">@r.Note</span> }
                    </td>
                    <td data-label="Application says">@(r.Expected ?? "(blank)")</td>
                    <td data-label="Label says">@(r.Found ?? "(not found)")</td>
                </tr>
            }
            </tbody>
        </table>
        <p class="meta"><span id="total-wait"></span>Reading the label took @outcome.Seconds.ToString("0.0") seconds.</p>
        <div class="previews">
            @for (int i = 0; i < Model.ImageDataUrls.Count; i++)
            {
                <img class="preview" src="@Model.ImageDataUrls[i]" alt="Label image @(i + 1) of @Model.ImageDataUrls.Count that you uploaded">
            }
        </div>
    </section>
}

<form method="post" enctype="multipart/form-data" class="card" id="check-form">
    <h2>1. Label images</h2>
    <label for="LabelImages">Photos of the label <small>(front, back, and neck if they are separate; up to @LabelChecker.MaxImages images, JPG or PNG)</small></label>
    <input type="file" id="LabelImages" name="LabelImages" accept="image/jpeg,image/png,image/webp,image/gif" multiple required>
    <p class="meta">For best results, photograph each label close up. Small print reads much better when the photo shows mostly the label.</p>
    <div id="photo-editor" hidden>
        <p><strong>Optional:</strong> if the text on a photo is sideways, press <strong>Turn left</strong> or <strong>Turn right</strong> until it reads normally.
            To help the reader with small print, drag on the photo to draw a box around the label.</p>
        <div class="photo-cards" id="photo-cards"></div>
    </div>

    <h2 style="margin-top:28px">2. What the application says</h2>
    <div class="grid">
        <div><label asp-for="App.BrandName">Brand name</label><input asp-for="App.BrandName" type="text" required></div>
        <div><label asp-for="App.ClassType">Class / type</label><input asp-for="App.ClassType" type="text" required></div>
        <div><label asp-for="App.AlcoholContent">Alcohol content <small>(for example 45%)</small></label><input asp-for="App.AlcoholContent" type="text" required></div>
        <div><label asp-for="App.NetContents">Net contents <small>(for example 750 mL)</small></label><input asp-for="App.NetContents" type="text" required></div>
        <div><label asp-for="App.Bottler">Bottler name and address</label><input asp-for="App.Bottler" type="text" required></div>
        <div><label asp-for="App.CountryOfOrigin">Country of origin <small>(imports only)</small></label><input asp-for="App.CountryOfOrigin" type="text"></div>
    </div>
    <p class="meta">The government warning is checked against the required wording automatically.</p>
    <button type="submit" id="check-button">Check label</button>
</form>

@section Scripts {
    <script>
        const form = document.getElementById('check-form');
        const input = document.getElementById('LabelImages');
        let photos = [];

        input.addEventListener('change', async () => {
            photos.forEach(p => p.bitmap?.close());
            photos = [];
            const cards = document.getElementById('photo-cards');
            cards.replaceChildren();
            for (const [i, file] of [...input.files].entries()) {
                const photo = { file, turns: 0, crop: null, bitmap: await createImageBitmap(file).catch(() => null) };
                photos.push(photo);
                if (photo.bitmap) cards.append(photoCard(photo, i + 1, input.files.length));
            }
            document.getElementById('photo-editor').hidden = cards.children.length === 0;
        });

        function photoCard(photo, number, count) {
            const canvas = document.createElement('canvas');
            canvas.setAttribute('aria-label', `Photo ${number} of ${count}. Drag to draw a box around the label.`);
            const button = (text, action) => {
                const b = document.createElement('button');
                b.type = 'button';
                b.className = 'secondary';
                b.textContent = text;
                b.addEventListener('click', () => { action(); draw(photo, canvas); });
                return b;
            };
            const tools = document.createElement('div');
            tools.className = 'photo-tools';
            tools.append(
                button('Turn left', () => { photo.turns = (photo.turns + 3) % 4; photo.crop = null; }),
                button('Turn right', () => { photo.turns = (photo.turns + 1) % 4; photo.crop = null; }),
                button('Clear box', () => { photo.crop = null; }));
            const caption = document.createElement('figcaption');
            caption.textContent = photo.file.name;
            const card = document.createElement('figure');
            card.className = 'photo-card';
            card.append(canvas, tools, caption);
            dragToCrop(photo, canvas);
            draw(photo, canvas);
            return card;
        }

        // Shows the photo turned as chosen, with everything outside the crop box dimmed.
        function draw(photo, canvas) {
            const b = photo.bitmap, sideways = photo.turns % 2 === 1;
            const width = sideways ? b.height : b.width, height = sideways ? b.width : b.height;
            const scale = Math.min(420 / width, 420 / height);
            canvas.width = Math.round(width * scale);
            canvas.height = Math.round(height * scale);
            const c = canvas.getContext('2d');
            c.save();
            c.translate(canvas.width / 2, canvas.height / 2);
            c.rotate(photo.turns * Math.PI / 2);
            c.drawImage(b, -b.width * scale / 2, -b.height * scale / 2, b.width * scale, b.height * scale);
            c.restore();
            if (!photo.crop) return;
            const { x, y, w, h } = photo.crop, W = canvas.width, H = canvas.height;
            c.fillStyle = 'rgba(0, 0, 0, 0.55)';
            c.fillRect(0, 0, W, y * H);
            c.fillRect(0, (y + h) * H, W, (1 - y - h) * H);
            c.fillRect(0, y * H, x * W, h * H);
            c.fillRect((x + w) * W, y * H, (1 - x - w) * W, h * H);
            c.strokeStyle = '#1d4ed8';
            c.lineWidth = 3;
            c.strokeRect(x * W, y * H, w * W, h * H);
        }

        function dragToCrop(photo, canvas) {
            let start = null;
            const point = e => {
                const r = canvas.getBoundingClientRect();
                return { x: Math.min(1, Math.max(0, (e.clientX - r.left) / r.width)), y: Math.min(1, Math.max(0, (e.clientY - r.top) / r.height)) };
            };
            canvas.addEventListener('pointerdown', e => { start = point(e); canvas.setPointerCapture(e.pointerId); });
            canvas.addEventListener('pointermove', e => {
                if (!start) return;
                const p = point(e);
                photo.crop = { x: Math.min(start.x, p.x), y: Math.min(start.y, p.y), w: Math.abs(p.x - start.x), h: Math.abs(p.y - start.y) };
                draw(photo, canvas);
            });
            canvas.addEventListener('pointerup', () => {
                start = null;
                if (photo.crop && (photo.crop.w < 0.05 || photo.crop.h < 0.05)) photo.crop = null;
                draw(photo, canvas);
            });
        }

        form.addEventListener('submit', async event => {
            event.preventDefault();
            const button = document.getElementById('check-button');
            button.disabled = true;
            button.textContent = 'Checking…';
            const files = new DataTransfer();
            const chosen = photos.length ? photos : [...input.files].map(file => ({ file, turns: 0, crop: null }));
            for (const photo of chosen) files.items.add(await prepareImage(photo.file, photo.turns, photo.crop));
            input.files = files.files;
            try { sessionStorage.setItem('checkStarted', Date.now()); } catch { }
            form.submit();
        });

        const totalWait = document.getElementById('total-wait');
        try {
            const started = Number(sessionStorage.getItem('checkStarted'));
            sessionStorage.removeItem('checkStarted');
            if (totalWait && started) totalWait.textContent = `Total wait ${((Date.now() - started) / 1000).toFixed(1)} seconds. `;
        } catch { }
    </script>
}
